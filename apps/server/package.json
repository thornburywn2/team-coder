{
  "name": "@team-coder/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:verify": "bun run src/db/verify-notify.ts",
    "db:clean": "bun run src/db/clean-test-data.ts",
    "demo:seed": "bun run src/db/demo-seed.ts && bun run src/db/demo-seed-apollo.ts",
    "demo:seed:apollo": "bun run src/db/demo-seed-apollo.ts",
    "verify:ws": "bun run src/verify-ws.ts",
    "verify:hooks": "bun run src/simulate-hooks.ts",
    "verify:ownership": "bun run src/verify-ownership.ts",
    "verify:mcp": "bun run src/verify-mcp.ts",
    "verify:gitpoll": "bun run src/verify-gitpoll.ts",
    "verify:report": "bun run src/verify-report.ts",
    "verify:isolation": "bun run src/verify-isolation.ts",
    "verify:notes": "bun run src/verify-notes.ts",
    "verify:decompose": "bun run src/verify-decompose.ts",
    "verify:proposals": "bun run src/verify-proposals.ts",
    "verify:inheritance": "bun run src/verify-inheritance.ts",
    "verify:capabilities": "bun run src/verify-capabilities.ts",
    "verify:reusekit": "bun run src/verify-reusekit.ts",
    "verify:audit": "bun run src/verify-audit.ts",
    "verify:collisions": "bun run src/verify-collisions.ts",
    "verify:polish": "bun run src/verify-polish.ts",
    "verify:extras": "bun run src/verify-extras.ts",
    "verify:locks": "bun run src/verify-locks.ts",
    "verify:all": "bun run db:verify && bun run verify:ws && bun run verify:hooks && bun run verify:ownership && bun run verify:mcp && bun run verify:gitpoll && bun run verify:report && bun run verify:isolation && bun run verify:notes && bun run verify:decompose && bun run verify:proposals && bun run verify:inheritance && bun run verify:reusekit && bun run verify:capabilities && bun run verify:audit && bun run verify:collisions && bun run verify:polish && bun run verify:extras && bun run verify:locks"
  },
  "dependencies": {
    "@team-coder/shared": "workspace:*",
    "@hono/mcp": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.28.1"
  }
}
