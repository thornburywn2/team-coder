# ── Team Coder environment ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# ── Containerized deploy (docker compose up -d --build) ───────────────────
# The compose file reads these. At minimum, change TEAM_TOKEN for a real deploy.
TEAM_TOKEN=change-me-team-token
APP_PORT=6300                  # host port the portal is served on
POSTGRES_USER=teamcoder
POSTGRES_PASSWORD=teamcoder
POSTGRES_DB=teamcoder
POSTGRES_PORT=5436            # host port for Postgres (change if taken)
# Optional: tool-agnostic git contribution polling (per-project repo URLs in the DB)
ENABLE_GIT_POLL=
PRODUCT_REPO_POLL_SECONDS=300

# ── Security hardening (set these for a real deployment) ──────────────────
ADMIN_TOKEN=                   # require this (x-admin-token) to create projects; unset = open (dev only)
CORS_ORIGIN=                   # comma-separated allow-list of browser origins; empty = same-origin only
ENABLE_HSTS=                   # set to 1 when served over HTTPS (behind the TLS proxy)
RATE_LIMIT=                    # set to 0 to disable rate limiting (e.g. in CI); default on
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API=600             # per token/IP per window
RATE_LIMIT_HOOKS=1200
RATE_LIMIT_MCP=600
RATE_LIMIT_PROJECTS=10         # project creation is deliberately tight
TOKEN_RATES_JSON=              # override token $ rates, e.g. {"opus":{"input":15,"output":75,"cacheRead":1.5}}
GIT_LOG_LIMIT=5000             # max commits ingested per poll

# ── TLS reverse proxy + backups (docker compose --profile prod up -d) ─────
TC_DOMAIN=localhost            # real domain → Caddy provisions an automatic HTTPS cert
BACKUP_INTERVAL_SECONDS=86400  # Postgres backup cadence
BACKUP_KEEP=7                  # number of backups to retain

# ── Local dev (running Bun on the host, Postgres via docker-compose.dev.yml) ──
PORT=6300
NODE_ENV=development
# host-side DB URL for `bun run db:migrate/seed` and `bun run dev` (dev Postgres on 5436)
DATABASE_URL=postgres://teamcoder:teamcoder@localhost:5436/teamcoder
