# ── Team Coder environment ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# ── Containerized deploy (docker compose up -d --build) ───────────────────
# The compose file reads these. At minimum, change TEAM_TOKEN for a real deploy.
TEAM_TOKEN=change-me-team-token
APP_PORT=6300                  # host port the portal is served on
POSTGRES_USER=teamcoder
POSTGRES_PASSWORD=teamcoder
POSTGRES_DB=teamcoder
POSTGRES_PORT=5436            # host port for Postgres (change if taken)
# Optional: tool-agnostic git contribution polling (per-project repo URLs in the DB)
ENABLE_GIT_POLL=
PRODUCT_REPO_POLL_SECONDS=300

# ── Local dev (running Bun on the host, Postgres via docker-compose.dev.yml) ──
PORT=6300
NODE_ENV=development
# host-side DB URL for `bun run db:migrate/seed` and `bun run dev` (dev Postgres on 5436)
DATABASE_URL=postgres://teamcoder:teamcoder@localhost:5436/teamcoder
