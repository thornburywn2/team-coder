# ── Team Coder environment ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# Server
PORT=6300
NODE_ENV=development

# Postgres (matches docker-compose.yml — dedicated instance on 5436)
DATABASE_URL=postgres://teamcoder:teamcoder@localhost:5436/teamcoder

# Auth (two-tier)
#  - TEAM_TOKEN: single shared passphrase humans enter to load the web portal
TEAM_TOKEN=change-me-team-token
#  - Per-dev agent tokens are seeded into the DB at setup (see scripts/seed).
#    Each coder puts their personal token in their Claude Code MCP + hook config.

# Product repo (separate hackathon product) — cloned locally and polled
# for git-log/git-who ownership signal blended with live hook activity.
PRODUCT_REPO_URL=
PRODUCT_REPO_PATH=.product-repo
PRODUCT_REPO_POLL_SECONDS=300

# Web (Vite) — public env must be prefixed VITE_
VITE_API_URL=http://localhost:6300
VITE_WS_URL=ws://localhost:6300/ws
